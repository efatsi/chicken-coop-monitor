// Copy to arduino_secrets.h (git-ignored). Device login name and key come
// from adding the Nano ESP32 as a manual device in Arduino Cloud.
// WiFi must be 2.4 GHz; the ESP32 can't join 5 GHz.
#define SECRET_DEVICE_LOGIN_NAME "your-device-id"
#define SECRET_DEVICE_KEY "your-device-secret-key"
#define SECRET_SSID "your-network"
#define SECRET_OPTIONAL_PASS "your-password"
